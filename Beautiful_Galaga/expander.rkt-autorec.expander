#lang br/quicklang
(require "expander-runtime.rkt")
(provide (all-defined-out))

;; Module begin — drop the parse tree straight into #%module-begin.
(define-macro (module-begin PARSE-TREE)
  #'(#%module-begin PARSE-TREE))
(provide (rename-out [module-begin #%module-begin]))

;; program: game-def play-def
(define-macro (program GAME-DEF PLAY-DEF)
  #'(begin GAME-DEF PLAY-DEF))

;; game-def: GAME ID { game-item* }
(define-macro (game-def NAME ITEM ...)
  #'(begin ITEM ...))

;; canvas-def: CANVAS DIMENSION
(define-macro (canvas-def DIM)
  (define parts (regexp-split #px"x" (syntax->datum #'DIM)))
  (with-pattern ([W (string->number (car parts))]
                 [H (string->number (cadr parts))])
    #'(register-canvas! W H)))

;; play-def: PLAY ID
(define-macro (play-def NAME)
  #'(play-game! 'NAME))

;; game-item: entity-def | canvas-def
;; Just a wrapper the parser inserts; unwrap it.
(define-macro (game-item ITEM) #'ITEM)

;; entity-def: ENTITY ID { entity-prop* }
;; For now, ignore the props — just register the entity by name.
(define-macro (entity-def NAME PROP ...)
  #'(begin
      (register-entity! 'NAME)
      (PROP 'NAME) ...))

(define-macro (size-def V) #'(λ (n) (set-entity-prop! n 'size V)))

(define-macro (color-def V)
  #'(λ (n) (set-entity-prop! n 'color (->color-string V))))

(define-macro (picture-def V)  
  #'(λ (n) (set-entity-prop! n 'picture (->picture-symbol V))))

(define-macro (entity-prop ITEM) #'ITEM)

(define-macro-cases value
  [(_ V)       #'V]
  [(_ V ...)   #'(list V ...)])

(define-macro (velocity-def V)
  #'(λ (n) (set-entity-prop! n 'velocity V)))

(define-macro (bounce-off-def V)
  #'(λ (n) (set-entity-prop! n 'bounce-off V)))

(define-macro (speed-def V)
  #'(λ (n) (set-entity-prop! n 'speed V)))

(define-macro (controls-def BINDINGS)
  #'(λ (n) (set-entity-prop! n 'controls BINDINGS)))

(define-macro (control-list KEY ...)
  (with-pattern ([(SYM ...)
                  (map (λ (s) (string->symbol (syntax->datum s)))
                       (syntax->list #'(KEY ...)))])
    #'(list 'SYM ...)))

(define-macro (position-def V)
  #'(λ (n) (set-entity-prop! n 'position V)))

(define-macro-cases custom-prop
  [(_ KEY VAL)
   (with-pattern ([SYM (string->symbol (format "~a" (syntax->datum #'KEY)))])
     #'(λ (n) (set-entity-prop! n 'SYM VAL)))]
  [(_ KEY OP VAL)
   (with-pattern ([SYM (string->symbol (format "~a" (syntax->datum #'KEY)))])
     #'(λ (n) (set-entity-prop! n 'SYM VAL)))])